# Generated by `libxr stm32 setup`; edit the values in the "Project settings" block only.

# ---- Project settings --------------------------------------------------------
set(LIBXR_SYSTEM FreeRTOS)
set(LIBXR_DRIVER st)
set(XROBOT_MODULES_DIR "${CMAKE_CURRENT_SOURCE_DIR}/Modules")
# User sources of the application; "" when CMakeLists.txt adds them itself.
set(LIBXR_USER_SOURCES_GLOB "${CMAKE_CURRENT_SOURCE_DIR}/User/*.cpp")
# Optimization level of the application in Debug builds and of everything in Release builds;
# "" keeps the level of the toolchain file.
set(LIBXR_OPT_DEBUG "-Og")
set(LIBXR_OPT_RELEASE "-O3")

# ---- LibXR -------------------------------------------------------------------
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(LIBXR_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/Middlewares/Third_Party/LibXR"
    CACHE PATH "LibXR source directory")
add_subdirectory("${LIBXR_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/LibXR")
target_link_libraries(xr PUBLIC stm32cubemx)
target_include_directories(xr PUBLIC Core/Inc User)
target_compile_features(xr PUBLIC cxx_std_20)

# ---- Application -------------------------------------------------------------
set_target_properties(${CMAKE_PROJECT_NAME} PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED ON)
if(LIBXR_USER_SOURCES_GLOB)
    file(GLOB LIBXR_USER_SOURCES CONFIGURE_DEPENDS "${LIBXR_USER_SOURCES_GLOB}")
    target_sources(${CMAKE_PROJECT_NAME} PRIVATE ${LIBXR_USER_SOURCES})
endif()
target_link_libraries(${CMAKE_PROJECT_NAME} xr)
# Target options follow CMAKE_<LANG>_FLAGS_<CONFIG> on the compile line, so the last -O decides.
target_compile_options(${CMAKE_PROJECT_NAME} PRIVATE
    $<$<CONFIG:Debug>:${LIBXR_OPT_DEBUG}> $<$<CONFIG:Release>:${LIBXR_OPT_RELEASE}>)

# ---- Library optimization ----------------------------------------------------
# Debug builds keep xr and the CubeMX libraries optimized (-O2); Release builds compile them at
# LIBXR_OPT_RELEASE, like the application.
set(LIBXR_LIBRARIES xr)
if(IS_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/cmake/stm32cubemx")
    get_directory_property(LIBXR_CUBEMX_TARGETS
        DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/cmake/stm32cubemx" BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS LIBXR_CUBEMX_TARGETS)
        get_target_property(target_type ${target} TYPE)
        if(NOT target_type STREQUAL "INTERFACE_LIBRARY")
            list(APPEND LIBXR_LIBRARIES ${target})
        endif()
    endforeach()
endif()
foreach(library IN LISTS LIBXR_LIBRARIES)
    target_compile_options(${library} PRIVATE
        $<$<CONFIG:Debug>:-O2> $<$<CONFIG:Release>:${LIBXR_OPT_RELEASE}>)
endforeach()

# ---- Firmware images ---------------------------------------------------------
# Each link of the application also writes <project>.hex and <project>.bin next to the ELF.
add_custom_command(TARGET ${CMAKE_PROJECT_NAME} POST_BUILD
    WORKING_DIRECTORY $<TARGET_FILE_DIR:${CMAKE_PROJECT_NAME}>
    COMMAND ${CMAKE_OBJCOPY} --output-target ihex
        $<TARGET_FILE_NAME:${CMAKE_PROJECT_NAME}> ${CMAKE_PROJECT_NAME}.hex
    COMMAND ${CMAKE_OBJCOPY} --output-target binary --strip-all
        $<TARGET_FILE_NAME:${CMAKE_PROJECT_NAME}> ${CMAKE_PROJECT_NAME}.bin
    VERBATIM)

# ---- Kept from the earlier LibXR.CMake ---------------------------------------
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU")
    target_compile_options(xr PRIVATE -Wno-tautological-compare -Wno-maybe-uninitialized)
endif()

if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    target_compile_options(xr PRIVATE -Wno-deprecated-volatile)
endif()
